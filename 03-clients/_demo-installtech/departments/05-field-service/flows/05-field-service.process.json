    { "from": "start", "to": "triage" },
    { "from": "triage", "to": "gw-contract" },
    { "from": "gw-contract", "to": "contract", "label": { "nl": "ja", "en": "yes" } },
    { "from": "contract", "to": "plannen" },
    { "from": "gw-contract", "to": "plannen", "label": { "nl": "nee", "en": "no" } },
    { "from": "plannen", "to": "voorbereiden" },
    { "from": "voorbereiden", "to": "uitvoeren" },
    { "from": "uitvoeren", "to": "gw-opgelost" },
    { "from": "gw-opgelost", "to": "vervolg", "label": { "nl": "nee", "en": "no" } },
    { "from": "vervolg", "to": "plannen", "label": { "nl": "tweede bezoek — als de klant belt", "en": "second visit — if the customer calls" } },
    { "from": "gw-opgelost", "to": "werkbon-papier", "label": { "nl": "ja", "en": "yes" } },
    { "from": "vervolg", "to": "werkbon-papier" },
    { "from": "werkbon-papier", "to": "tijd" },
    { "from": "tijd", "to": "werkbon-foto" },
    { "from": "werkbon-foto", "to": "overtypen", "label": { "nl": "soms pas vrijdag", "en": "sometimes only on Friday" } },
    { "from": "overtypen", "to": "controleren" },
    { "from": "controleren", "to": "end" }
  ]
