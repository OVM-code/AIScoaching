  "lanes": [
    { "id": "servicedesk", "label": { "nl": "Onthaal / service@", "en": "Front office / service@" } },
    { "id": "planner", "label": { "nl": "Planner-dispatcher", "en": "Planner / dispatcher" } },
    { "id": "technieker", "label": { "nl": "Technieker", "en": "Technician" } },
    { "id": "administratie", "label": { "nl": "Administratie", "en": "Back office" } }
  ],
  "nodes": [
